# Copy to .env and fill in. Never commit .env — only this file.
# docker compose reads .env automatically; values in docker-compose.yml's environment blocks win for
# the container-network addresses (db, redis), so the defaults below are for running on your host.

ENVIRONMENT=development

# ---------------------------------------------------------------- Database and storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/gp
STORAGE_ROOT=./.data/artifacts
PUBLIC_FILES_URL=http://localhost:8000/files
STORAGE_BUCKET=artifacts

# Supabase (D-01). Project "isnad" (ap-south-1). URL and anon key are safe to commit — the anon
# key ships in the frontend bundle regardless and is only usable through RLS. The service key is
# a real secret; leave it blank unless a component actually needs the admin client.
SUPABASE_URL=https://wawbngrkbmlidliybkbw.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Indhd2JuZ3JrYm1saWRsaXlia2J3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkzNzMwNDYsImV4cCI6MjEwNDk0OTA0Nn0.hij6pi9w0_xAOkl2VF1nQ_uFRZP_EqeGXnkU_JNNwSQ
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------- Queue
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- Auth
# HS256 signing secret, at least 32 characters, for POST /auth/dev-login tokens only. Any random
# string works — it never needs to match anything on Supabase's side. Supabase-issued tokens are
# verified separately via the project's JWKS (SUPABASE_URL above), since the isnad project signs
# with an asymmetric key (ES256), not a shared secret — see api/src/api/auth.py.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-.env-at-least-32-characters-long
ENABLE_DEV_LOGIN=true
CORS_ORIGINS=["http://localhost:5173"]

# ---------------------------------------------------------------- Adapters
# FAKE_ADAPTERS=true runs the whole platform end to end with canned responses — no API spend.
FAKE_ADAPTERS=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
SEARCH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Frontend
VITE_API_URL=http://localhost:8000

# Opt in to real Supabase Auth for P-01/P-02 (default is dev sign-in, no password). The API
# verifies these tokens via JWKS automatically — no extra secret needed on that side.
# VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=https://wawbngrkbmlidliybkbw.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Indhd2JuZ3JrYm1saWRsaXlia2J3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkzNzMwNDYsImV4cCI6MjEwNDk0OTA0Nn0.hij6pi9w0_xAOkl2VF1nQ_uFRZP_EqeGXnkU_JNNwSQ
