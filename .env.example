# Copy to .env and fill in. Never commit .env — only this file.
# docker compose reads .env automatically; values in docker-compose.yml's environment blocks win for
# the container-network addresses (db, redis), so the defaults below are for running on your host.

ENVIRONMENT=development

# ---------------------------------------------------------------- Database and storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/gp
# Where generated files (videos, images, documents) go — api and worker must agree:
#   local    = STORAGE_ROOT on disk, served by the API at PUBLIC_FILES_URL (development only)
#   supabase = the PRIVATE Supabase Storage bucket STORAGE_BUCKET; downloads are signed URLs that
#              expire after DOWNLOAD_URL_EXPIRES_IN seconds. Needs SUPABASE_URL + SUPABASE_SERVICE_KEY.
# Either way a run's files are stored at artifacts/{user_id}/{run_id}/...
STORAGE_BACKEND=local
STORAGE_ROOT=./.data/artifacts
PUBLIC_FILES_URL=http://localhost:8000/files
STORAGE_BUCKET=artifacts
DOWNLOAD_URL_EXPIRES_IN=300

# Supabase (D-01) — only for VITE_AUTH_MODE=supabase or STORAGE_BACKEND=supabase; local development
# needs none of it. Use your own project: Dashboard → Project Settings → API. The URL and anon key
# end up in the frontend bundle anyway and are only usable through RLS. The service key is a real
# secret (it bypasses RLS): only the api and worker read it, only for STORAGE_BACKEND=supabase,
# and it never gets a VITE_ prefix.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------- Queue
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- Auth
# HS256 signing secret, at least 32 characters, for POST /auth/dev-login tokens only. Any random
# string works — it never needs to match anything on Supabase's side. Supabase-issued tokens are
# verified separately via the project's JWKS (SUPABASE_URL above), since the isnad project signs
# with an asymmetric key (ES256), not a shared secret — see api/src/api/auth.py.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start with ENVIRONMENT=production while this is the example value or shorter
# than 32 characters: it also signs the Google connect `state`.
JWT_SECRET=change-me-in-.env-at-least-32-characters-long
# Dev-login tokens (HS256, signed with JWT_SECRET) are accepted only while this is on, and never
# with ENVIRONMENT=production. Turn it off to accept Supabase sign-ins only.
ENABLE_DEV_LOGIN=true
CORS_ORIGINS=["http://localhost:5173"]

# ---------------------------------------------------------------- Adapters
# FAKE_ADAPTERS=true runs the whole platform end to end with canned responses — no API spend.
FAKE_ADAPTERS=true
# The Researcher's search, FAKE_ADAPTERS=false only: tavily (needs SEARCH_API_KEY) or fake (made-up
# sources — choose it to try real mode without a key). Left empty: tavily if SEARCH_API_KEY is set;
# with no key either, each Researcher step fails saying so. It never quietly falls back to fake.
SEARCH_PROVIDER=
# The longest one attempt of a step may run before the worker stops it (not retried). Each service
# call has its own shorter timeout; this is the backstop. Seconds; 0 turns it off.
STEP_TIMEOUT_S=1800
SEARCH_API_KEY=

# ---------------------------------------------------------------- LLM (the Writer), FAKE_ADAPTERS=false only
# local      = LM Studio (or Ollama) on this machine: no key, no per-token cost. The default.
# openai     = needs OPENAI_API_KEY.        openrouter = needs OPENROUTER_API_KEY.
# fake       = canned answers even in real mode. Left empty: openai if OPENAI_API_KEY is set, else local.
# Setup and model choice: SETUP.md "Local LLM".
LLM_PROVIDER=local
# The model id LM Studio shows (`lms ls`, or GET http://localhost:1234/v1/models). Required for
# local and openrouter; openai defaults to OPENAI_MODEL.
LLM_MODEL=
# Overrides the provider's address. Unset, local is LLM_LOCAL_BASE_URL — LM Studio on
# http://localhost:1234/v1, or http://host.docker.internal:1234/v1 from the Docker worker
# (docker-compose.yml sets that). Ollama: http://localhost:11434/v1.
LLM_BASE_URL=
# json_schema (constrained decoding where supported) → json_object → none. The adapter falls back
# by itself when a server refuses a mode; set this only to skip straight to one.
LLM_STRUCTURED=json_schema
# One deadline for the whole answer, in seconds. A long article on a local model can take minutes.
LLM_TIMEOUT_S=300
LLM_MAX_OUTPUT_TOKENS=4096
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENROUTER_API_KEY=
# LLM_API_KEY=     # used instead of the provider's own variable, if set

# ---------------------------------------------------------------- Email, FAKE_ADAPTERS=false only
# gmail = each Email step sends as the Google account it names (Settings → Connections). The default.
# smtp  = through this server's SMTP. Under docker compose that is the mailpit service: every message
#         is caught at http://localhost:8025 and nothing leaves this machine — use it to try email.
EMAIL_TRANSPORT=gmail
# Unset under docker compose: mailpit, port 1025. For a real server: its host, 587 + SMTP_STARTTLS=true
# (or 465 + SMTP_SSL=true), and its login.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
EMAIL_FROM=ISNAD <isnad@localhost>

# ---------------------------------------------------------------- Google connections (D-09)
# Settings → Connections. Setup steps (Cloud Console, test users, redirect URIs): SETUP.md
# "Connect Google". Read by both the API (connect/disconnect) and the worker (token refresh).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed exactly under the OAuth client's "Authorised redirect URIs".
# Production: https://<your-host>/api/connections/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/connections/google/callback
# Where the browser returns after Google: {FRONTEND_URL}/settings/connections
FRONTEND_URL=http://localhost:5173
# Fernet key that encrypts stored Google tokens. Comma-separate several to rotate (the first encrypts).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# ---------------------------------------------------------------- Frontend
VITE_API_URL=http://localhost:8000

# Opt in to real Supabase Auth for P-01/P-02 (default is dev sign-in, no password). The API
# verifies these tokens via JWKS automatically — no extra secret needed on that side.
# VITE_AUTH_MODE=supabase
# The same project as SUPABASE_URL / SUPABASE_ANON_KEY above.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
