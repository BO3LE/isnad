  "info": {
    "description": "Visual AI-agent workflow platform \u2014 C2 api. Contract agreed in GP-plan \u00a75.3.",
    "title": "GP Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/agents/catalog": {
      "get": {
        "description": "Every installed agent with the JSON Schema of its configuration. Drives the palette and the\nconfiguration drawer, so a new agent appears with a working form and no frontend change (NFR-04).\nEmpty until a worker has started.",
