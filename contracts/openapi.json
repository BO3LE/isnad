{
  "components": {
    "schemas": {
      "AgentFamily": {
        "enum": [
          "create",
          "distribute"
        ],
        "title": "AgentFamily",
        "type": "string"
      },
      "AgentInput": {
        "additionalProperties": false,
        "description": "One thing an agent needs to run, and where it may come from.",
        "properties": {
          "accepts": {
            "description": "Output names an earlier step may supply this under, in the order the agent prefers them",
            "items": {
              "type": "string"
            },
            "title": "Accepts",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "required": {
            "description": "The step cannot run without it",
            "title": "Required",
            "type": "boolean"
          },
          "settable": {
            "description": "The user can type it in the step's settings; otherwise only an earlier step can supply it",
            "title": "Settable",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "accepts",
          "required",
          "settable"
        ],
        "title": "AgentInput",
        "type": "object"
      },
      "AgentManifest": {
        "additionalProperties": false,
        "properties": {
          "config_schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "JSON Schema of the configuration form. Filled from the agent's config model at runtime.",
            "title": "Config Schema"
          },
          "description": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "family": {
            "$ref": "#/components/schemas/AgentFamily",
            "default": "create"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lucide icon name, e.g. 'telescope'",
            "title": "Icon"
          },
          "input_type": {
            "description": "Model name in contracts.agent_io",
            "title": "Input Type",
            "type": "string"
          },
          "inputs": {
            "description": "What the agent needs. Filled from its input model at runtime.",
            "items": {
              "$ref": "#/components/schemas/AgentInput"
            },
            "title": "Inputs",
            "type": "array"
          },
          "name": {
            "description": "Unique agent_type",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Name",
            "type": "string"
          },
          "output_type": {
            "description": "Model name in contracts.agent_io",
            "title": "Output Type",
            "type": "string"
          },
          "outputs": {
            "description": "What the agent hands on. Filled from its output model at runtime.",
            "items": {
              "$ref": "#/components/schemas/AgentOutput"
            },
            "title": "Outputs",
            "type": "array"
          },
          "requires_approval": {
            "default": false,
            "description": "True for agents that send content out of the platform",
            "title": "Requires Approval",
            "type": "boolean"
          },
          "title": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "version": {
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "title",
          "description",
          "input_type",
          "output_type"
        ],
        "title": "AgentManifest",
        "type": "object"
      },
      "AgentOutput": {
        "additionalProperties": false,
        "description": "One thing an agent hands on to the steps after it.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "title": {
            "description": "What a person calls it, e.g. 'article'",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "name",
          "title"
        ],
        "title": "AgentOutput",
        "type": "object"
      },
      "ApprovalDecision": {
        "enum": [
          "approve",
          "reject"
        ],
        "title": "ApprovalDecision",
        "type": "string"
      },
      "ApprovalRequest": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/ApprovalDecision"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "decision"
        ],
        "title": "ApprovalRequest",
        "type": "object"
      },
      "DevLoginRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "DevLoginRequest",
        "type": "object"
      },
      "GraphEdge": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "source": {
            "format": "uuid",
            "title": "Source",
            "type": "string"
          },
          "target": {
            "format": "uuid",
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "target"
        ],
        "title": "GraphEdge",
        "type": "object"
      },
      "GraphNode": {
        "additionalProperties": false,
        "description": "One agent on the canvas. `id` is generated by the frontend (crypto.randomUUID()).",
        "properties": {
          "agent_type": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Agent Type",
            "type": "string"
          },
          "configuration": {
            "additionalProperties": true,
            "title": "Configuration",
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          },
          "requires_approval": {
            "default": false,
            "title": "Requires Approval",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "agent_type"
        ],
        "title": "GraphNode",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LogEntry": {
        "properties": {
          "agent_type": {
            "title": "Agent Type",
            "type": "string"
          },
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "node_id": {
            "format": "uuid",
            "title": "Node Id",
            "type": "string"
          },
          "retry_count": {
            "default": 0,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Retry Count",
            "type": "integer"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/NodeStatus"
          }
        },
        "required": [
          "node_id",
          "agent_type",
          "status",
          "id",
          "run_id"
        ],
        "title": "LogEntry",
        "type": "object"
      },
      "Me": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "Me",
        "type": "object"
      },
      "NodeState": {
        "properties": {
          "agent_type": {
            "title": "Agent Type",
            "type": "string"
          },
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "node_id": {
            "format": "uuid",
            "title": "Node Id",
            "type": "string"
          },
          "retry_count": {
            "default": 0,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Retry Count",
            "type": "integer"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/NodeStatus"
          }
        },
        "required": [
          "node_id",
          "agent_type",
          "status"
        ],
        "title": "NodeState",
        "type": "object"
      },
      "NodeStatus": {
        "enum": [
          "pending",
          "running",
          "retrying",
          "awaiting_approval",
          "success",
          "failed",
          "skipped"
        ],
        "title": "NodeStatus",
        "type": "string"
      },
      "OutputLink": {
        "description": "How to get at one output: a URL for a file, the words themselves for text.",
        "properties": {
          "expires_in": {
            "default": 0,
            "title": "Expires In",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "id"
        ],
        "title": "OutputLink",
        "type": "object"
      },
      "Position": {
        "properties": {
          "x": {
            "default": 0,
            "title": "X",
            "type": "number"
          },
          "y": {
            "default": 0,
            "title": "Y",
            "type": "number"
          }
        },
        "title": "Position",
        "type": "object"
      },
      "RunCreated": {
        "properties": {
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          }
        },
        "required": [
          "run_id",
          "status"
        ],
        "title": "RunCreated",
        "type": "object"
      },
      "RunOutput": {
        "description": "One thing a run produced.\n\n`id` is what GET /outputs/{id} resolves: a download URL for a file, the content itself for\ntext. `filename`, `mime_type` and `bytes` are a file's; text and links carry none of them.",
        "properties": {
          "agent_type": {
            "title": "Agent Type",
            "type": "string"
          },
          "bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bytes"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "text",
              "file",
              "url"
            ],
            "title": "Kind",
            "type": "string"
          },
          "mime_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mime Type"
          },
          "node_id": {
            "format": "uuid",
            "title": "Node Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "node_id",
          "agent_type",
          "kind",
          "created_at"
        ],
        "title": "RunOutput",
        "type": "object"
      },
      "RunState": {
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "failed_nodes": {
            "default": 0,
            "title": "Failed Nodes",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/NodeState"
            },
            "title": "Nodes",
            "type": "array"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "total_nodes": {
            "default": 0,
            "title": "Total Nodes",
            "type": "integer"
          },
          "workflow_id": {
            "format": "uuid",
            "title": "Workflow Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "workflow_id",
          "status"
        ],
        "title": "RunState",
        "type": "object"
      },
      "RunStatus": {
        "enum": [
          "queued",
          "running",
          "awaiting_approval",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "RunSummary": {
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "const": "rejected",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          }
        },
        "required": [
          "id",
          "status",
          "created_at"
        ],
        "title": "RunSummary",
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "ValidationError": {
