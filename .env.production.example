# Production settings for docker-compose.prod.yml — copy to .env.production ON THE SERVER and fill in.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# Never commit .env.production (.gitignore covers it). [SECRET] marks values that must never be
# shared, pasted into chat, or given a VITE_ prefix. Lines left commented use the default shown in
# docker-compose.prod.yml / the settings classes. Don't leave a true/false or number setting as an
# empty "NAME=" — the API refuses to start on an empty boolean; comment it out instead.
# Guide: docs/deployment.md. scripts/deploy.sh checks the required ones before starting anything.

# ================================================================ Public address (required)
# What Caddy serves. A bare hostname gets HTTPS from Let's Encrypt automatically:
#   isnad.example.com          your own domain (A record -> the server's public IP)
#   203-0-113-10.sslip.io      no domain: the server's IP with dashes + .sslip.io
#   http://203.0.113.10        plain HTTP on the IP — smoke test only (no Google sign-in)
DOMAIN=
# The URL people open, scheme included, no trailing slash: https://isnad.example.com
# FRONTEND_URL, CORS_ORIGINS and GOOGLE_REDIRECT_URI are derived from it (override below if needed).
PUBLIC_URL=
# Host ports Caddy publishes. Only change them for local testing; Let's Encrypt needs 80 and 443.
# HTTP_PORT=
# HTTPS_PORT=

# ================================================================ Database — Supabase Postgres (required)
# [SECRET] Supabase → Connect → "Session pooler" URI (port 5432, IPv4-compatible):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Not the transaction pooler (6543). The direct connection (db.<ref>.supabase.co) is IPv6-only
# unless the IPv4 add-on is enabled, and many VMs have no IPv6 route.
DATABASE_URL=
# [SECRET] Optional: a different URL just for `alembic upgrade head` (the migrate service).
# MIGRATE_DATABASE_URL=
# true = also run `python -m db.seed` on deploy (demo user + three template workflows). Idempotent.
# SEED_DEMO_DATA=
# Email of the seeded demo user (default demo@gp.local).
# SEED_DEMO_EMAIL=

# ================================================================ Supabase project (required)
# Project URL, e.g. https://<project-ref>.supabase.co. Used for token verification (JWKS), Storage,
# and — unless VITE_SUPABASE_URL is set — baked into the frontend build.
SUPABASE_URL=
# Public anon key (ships in the frontend bundle by design; only usable through RLS). Baked into the
# frontend build unless VITE_SUPABASE_ANON_KEY is set.
SUPABASE_ANON_KEY=
# [SECRET] service_role key — bypasses RLS. Only the api and worker read it (Storage uploads and
# signed download URLs). Dashboard → Project Settings → API keys.
SUPABASE_SERVICE_KEY=

# ================================================================ Storage
# supabase (default here) = private bucket STORAGE_BUCKET, downloads via signed URLs.
# "local" is development-only: the API does not serve /files in production.
# STORAGE_BACKEND=
# Bucket name (default artifacts). Must exist and be private.
# STORAGE_BUCKET=
# Lifetime of signed download links in seconds (default 300).
# DOWNLOAD_URL_EXPIRES_IN=

# ================================================================ Auth
# [SECRET] At least 32 random characters. Dev sign-in is off in production, but the API still accepts
# any HS256 token signed with this — so it must be strong and unique to this server:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Frontend sign-in mode, baked in at build time (default supabase — dev sign-in is disabled in production).
# VITE_AUTH_MODE=
# Override the frontend's Supabase URL / anon key (default: SUPABASE_URL / SUPABASE_ANON_KEY above).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Default ["<PUBLIC_URL>"] and <PUBLIC_URL>. JSON list for CORS_ORIGINS.
# CORS_ORIGINS=
# FRONTEND_URL=

# ================================================================ Adapters (required choice)
# true  = canned responses end to end, no API spend, no keys needed (a safe first deploy)
# false = real OpenAI / search / Google calls — needs the keys below
FAKE_ADAPTERS=
# [SECRET] Needed when FAKE_ADAPTERS=false.
OPENAI_API_KEY=
# Default gpt-4o.
# OPENAI_MODEL=
# [SECRET] Needed when FAKE_ADAPTERS=false.
SEARCH_API_KEY=

# ================================================================ Google connections (optional, D-09)
# Without these, Settings → Connections answers "not set up" and everything else works.
# OAuth client (Web application) in Google Cloud Console. Add this exact Authorised redirect URI:
#   <PUBLIC_URL>/api/connections/google/callback
GOOGLE_CLIENT_ID=
# [SECRET]
GOOGLE_CLIENT_SECRET=
# Default <PUBLIC_URL>/api/connections/google/callback — only set to override.
# GOOGLE_REDIRECT_URI=
# [SECRET] Fernet key(s) encrypting stored Google tokens; comma-separate to rotate (first encrypts).
# Losing it means every user reconnects Google. Generate:
#   docker run --rm python:3.11-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
CREDENTIALS_ENCRYPTION_KEY=
# Tie the OAuth callback to the browser that started it (default true).
# OAUTH_BIND_BROWSER=
